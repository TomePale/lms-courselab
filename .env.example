# Predložak konfiguracije. Kopirati u .env i po potrebi prilagoditi:
#   cp .env.example .env
# .env ne ulazi u repozitorij.

ENV=dev

# postgresql+asyncpg:// imenuje asinkroni upravljački program (driver)
DATABASE_URL=postgresql+asyncpg://courselab_user:courselab_pass@localhost:5432/courselab
# Testovi rade nad zasebnom bazom na istom poslužitelju
TEST_DATABASE_URL=postgresql+asyncpg://courselab_user:courselab_pass@localhost:5432/courselab_test

# Tajni ključ za potpis JWT tokena. Ovo je samo predložak: u .env upiši
# vlastiti nasumični ključ. Naredba radi na svim sustavima (i na Windowsima):
#   python -c "import secrets; print(secrets.token_hex(32))"
# ili, ako imaš OpenSSL (macOS, Linux, Git Bash):
#   openssl rand -hex 32
# S ovom vrijednošću aplikacija se namjerno ne pokreće.
JWT_SECRET_KEY=promijeni-me
JWT_ISSUER=lms-courselab
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
